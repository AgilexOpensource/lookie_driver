<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>driver_bringup</name>
  <version>0.1.0</version>
  <description>Lookie driver bringup: motor YAML, driver launch files, and joint name bridge</description>

  <maintainer email="contact@agilex.ai">Agilex Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>head_ros</exec_depend>
  <exec_depend>lift_ros</exec_depend>
  <exec_depend>fold_ros</exec_depend>
  <exec_depend>motor_ros</exec_depend>
  <exec_depend>agx_arm_ctrl</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
